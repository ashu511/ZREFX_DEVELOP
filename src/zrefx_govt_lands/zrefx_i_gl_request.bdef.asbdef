managed with additional save implementation in class zbp_refx_i_gl_request
unique;
strict ( 2 );

define behavior for ZREFX_I_GL_REQUEST alias GovtLand
persistent table zrefx_gl
lock master
authorization master ( global )
late numbering
with additional save
{
  create ( authorization : global );
  update;
  delete;

  field ( readonly ) RequestId;
  field ( mandatory ) Statuscode;

  association _RequestAttachments { create; }
  association _WorkflowInstance { create; }
  association _SiteVisit { create; }

  mapping for zrefx_gl
    {
      RequestId                  = request_id;
      Actualcompletiondate       = actualcompletiondate;
      Additionalcomments         = additionalcomments;
      Approvalstatus             = approvalstatus;
      Approvalstatuscode         = approvalstatuscode;
      Areasqmrequested           = areasqmrequested;
      Businessarea               = businessarea;
      Initiatorid                = initiatorid;
      Initiatorfullname          = initiatorfullname;
      Initiatororganization      = initiatororganization;
      Employeenumber             = employeenumber;
      Emailaddress               = emailaddress;
      Contactnumber              = contactnumber;
      Businessjustification      = businessjustification;
      Cablelengthkm              = cablelengthkm;
      Capacitymva                = capacitymva;
      Companycode                = companycode;
      Costcenter                 = costcenter;
      Currentprocessorrole       = currentprocessorrole;
      Currentprocessoruser       = currentprocessoruser;
      Currentstep                = currentstep;
      Currentstepchangedat       = currentstepchangedat;
      Externalprojectaccountno   = externalprojectaccountno;
      Facilitytype               = facilitytype;
      Gislocationlink            = gislocationlink;
      Gisprojectid               = gisprojectid;
      Gisdrawing                 = gisdrawing;
      Hijrienddate               = hijrienddate;
      Hijristartdate             = hijristartdate;
      Initiatedbyrole            = initiatedbyrole;
      Landcategory               = landcategory;
      Lengthmrequested           = lengthmrequested;
      Plancompletiondate         = plancompletiondate;
      Previousrequestno          = previousrequestno;
      Priority                   = priority;
      Profitcenter               = profitcenter;
      Projectapprovalyear        = projectapprovalyear;
      Projectbudgetyear          = projectbudgetyear;
      Projectcostsar             = projectcostsar;
      Projectenddate             = projectenddate;
      Projectname                = projectname;
      Projectstartdate           = projectstartdate;
      Requestdate                = requestdate;
      Requestdescription         = requestdescription;
      Requestor                  = requestor;
      Requestorcomments          = requestorcomments;
      Requestpurpose             = requestpurpose;
      Requesttype                = requesttype;
      Sourcedepartment           = sourcedepartment;
      Sourcesubsidiary           = sourcesubsidiary;
      Stagegateprojectno         = stagegateprojectno;
      Stationtype                = stationtype;
      Statuscode                 = statuscode;
      Voltagekv                  = voltagekv;
      Wbsprojectno               = wbsprojectno;
      Widthmrequested            = widthmrequested;
      UserId                     = userid;
      UserName                   = username;
      Region                     = region;
      City                       = city;
      GovtAuthority              = govtauthority;
      RequiredDate               = requireddate;
      Othercity                  = othercity;
      Title                      = title;
      Department                 = department;
      EstimatedProjectCost       = estimatedprojectcost;
      //            CurrentStepDesc            = currentstepdescription;
      ProjectnameA               = projectname_a;
      CurrentProcessorName       = currentprocessorname;
      CurrentProcessorDepartment = currentprocessordepartment;
      //      MileStoneDescription       = milestonedesc;
      Milestone                  = milestone;
      WorkflowInstanceId         = workflowinstanceid;
      //      MilestoneSequence          = milestonesequence;
      Sitearea                   = sitearea;
      ConfirmInformation         = confirminformation;
      ConsentDate                = consentdate;
      RequestorOrg               = req_org;
      RequestorOrgText           = req_org_text;
      RequestorOrgAText          = req_org_text_a;
      REDivOrg                   = re_division_org;
      REDivOrgText               = re_division_text;
      REDivOrgAText              = re_division_text_a;
      REReviewer                 = re_reviewer;
      RERevEmail                 = re_reviewer_email;
      REQFocalPoint              = req_focal_point;
      REQFocalPointEmail         = req_focal_point_email;
    }

}

define behavior for ZREFX_I_GL_REQUEST_ATTACHMENT alias ReqAttachment
persistent table zrefx_gl_req_a
lock dependent by _GLRequest
authorization dependent by _GLRequest
late numbering
with additional save
{
  update;
  delete;
  field ( readonly ) RequestId, AttachmentId;

  // Action to allow BgPF Class to update DMSID
  action updateDmsId parameter ZREFX_A_DMS_UPD_COM_OUT result [1] $self;

  //    static action upload
  //    parameter ZREFX_A_DMS_UPLOAD_IN
  //    result [1] ZREFX_A_DMS_UPLOAD_OUT;
  //
  //  static action delete
  //    parameter ZREFX_A_DMS_DELETE_IN
  //    result [1] $self;
  //
  //  static action download
  //    parameter ZREFX_A_DMS_DOWNLOAD_IN
  //    result [1] ZREFX_A_DMS_DOWNLOAD_OUT;

  static action download
    parameter ZREFX_A_DMS_COM_DOW_IN
    result [1] ZREFX_A_DMS_COM_DOW_OUT;

  association _GLRequest;
  mapping for zrefx_gl_req_a
    {
      RequestId    = request_id;
      AttachmentId = attachment_id;
      Category     = category;
      Dmsid        = dmsid;
      Documentname = documentname;
      Documenttype = documenttype;
      Filename     = filename;
      Mediatype    = mediatype;
      Mimetype     = mimetype;
      Content      = content;
      Notes        = notes;
      CreatedAt    = created_at;
      CreatedBy    = created_by;
    }

}

define behavior for ZREFX_I_GL_WORKFLOW_INSTANCE alias WorkflowInstance
persistent table zrefx_gl_workin
lock dependent by _GLRequest
authorization dependent by _GLRequest
late numbering
with additional save
{
  update;
  delete;
  field ( readonly ) LogUuid, RequestId;
  association _GLRequest;

  // Every time SBPA does a POST to this entity, this logic will run.
  determination updateParentStatus on modify { create; }

  mapping for zrefx_gl_workin
    {
      RequestId         = request_id;
      LogUuid           = log_uuid;
      WfInstanceId      = wf_instance_id;
      Approvalstep      = approvalstep;
      Approvalstepdesc  = approvalstepdesc;
      ApproverEmail     = approver_email;
      CurrentStatus     = current_status;
      CurrentOwner      = current_owner;
      Currentownerdesig = currentownerdesig;
      OrganizationField = organization_field;
      Comments          = comments;
      Region            = region;
      SubmissionDate    = submission_date;
      DecisionOutcome   = decision_outcome;
    }
}

define behavior for ZREFX_I_GL_SITEVISIT alias SiteVisit
persistent table zrefx_gl_sitevi
lock dependent by _GLRequest
late numbering
authorization dependent by _GLRequest
{
  update;
  delete;
  field ( readonly ) Id, RequestId;
  association _GLRequest;
  association _SiteAttachments { create; }
  association _SiteVisitNom { create; }

  mapping for zrefx_gl_sitevi
    {
      Id                   = id;
      RequestId            = request_id;
      Nomination           = nomination;
      Plannedvisitdatetime = plannedvisitdatetime;
      Actualvisitdatetime  = actualvisitdatetime;
      Engineer             = engineer;
      Statuscode           = statuscode;
      Status               = status;
      Reports              = reports;
      Widthmmeasured       = widthmmeasured;
      Lengthmmeasured      = lengthmmeasured;
      Areasqmmeasured      = areasqmmeasured;
      Obstacles            = obstacles;
      Safetyobservations   = safetyobservations;
      Sitenotes            = sitenotes;
      UserId               = userid;
      UserName             = username;
      Title                = title;
      Department           = department;
    }
}

define behavior for ZREFX_I_GL_SITEVISIT_ATT alias SiteVisitAttachment
persistent table zrefx_gl_visita
lock dependent by _GLRequest
authorization dependent by _GLRequest
late numbering
{
  update;
  delete;
  field ( readonly ) RequestId, Dmsid, SiteId;
  association _GLRequest;
  association _SiteVisit;

  mapping for zrefx_gl_visita
    {
      RequestId    = request_id;
      Dmsid        = dmsid;
      SiteId       = siteid;
      Category     = category;
      Documentname = documentname;
      DocumentType = documenttype;
      Filename     = filename;
      Mediatype    = mediatype;
      Notes        = notes;
      CreatedBy    = created_by;
      CreatedAt    = created_at;
    }
}

define behavior for ZREFX_I_GL_SITEVISITNOM alias SiteVisitNom
persistent table zrefx_gl_svn
lock dependent by _GLRequest
authorization dependent by _GLRequest
late numbering
{
  update;
  delete;
  field ( readonly ) Id, NominationId, RequestId;
  association _GLRequest;
  association _SiteVisit;

  mapping for zrefx_gl_svn
    {
      Id                = id;
      NominationId      = nomid;
      RequestId         = request_id;
      Nominatedby       = nominatedby;
      Nominatedat       = nominatedat;
      Engineer          = engineer;
      Visitreason       = visitreason;
      Priority          = priority;
      Preoposeddatetime = preoposeddatetime;
      Agreeddatetime    = agreeddatetime;
      Notes             = notes;
      Status            = status;
      Statuscode        = statuscode;
      Acceptedby        = acceptedby;
      Acceptedat        = acceptedat;
      Acceptancecomment = acceptancecomment;
      Declinereason     = declinereason;
      Department        = department;
      UserId            = userid;
      UserName          = username;
      Title             = title;
      Division          = division;
      EmailId           = emailid;
      ContactNo         = contactno;
    }
}