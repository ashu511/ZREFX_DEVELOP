projection;
strict ( 2 );

define behavior for ZREFX_C_GL_REQUEST //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _RequestAttachments { create; }
  use association _WorkflowInstance { create; }
  use association _SiteVisit { create; }
}

define behavior for ZREFX_C_GL_REQUEST_ATTACHMENT //alias <alias_name>
{
  use update;
  use delete;
  use action download;
  use association _GLRequest;
}

define behavior for ZREFX_C_GL_WORKFLOW_INSTANCE //alias <alias_name>
{
  use update;
  use delete;

  use association _GLRequest;
}

define behavior for ZREFX_C_GL_SITEVISIT //alias SiteVisit
{
  use update;
  use delete;

  use association _GLRequest;
  use association _SiteAttachments { create; }
  use association _SiteVisitNom { create; }
}

define behavior for ZREFX_C_GL_SITEVISIT_ATT //alias SiteVisitAttachment
{
  use update;
  use delete;

  use association _GLRequest;
  use association _SiteVisit;
}

define behavior for ZREFX_C_GL_SITEVISITNOM //alias SiteVisitNom
{
  use update;
  use delete;

  use association _GLRequest;
  use association _SiteVisit;
}