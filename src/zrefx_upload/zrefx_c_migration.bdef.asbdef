projection;
strict ( 2 );
use draft;
use side effects;
define behavior for ZREFX_C_MIGRATION alias Migration
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _ComplaintsItems { create; with draft; }
  use association _ClaimsItems { create; with draft; }
}

define behavior for ZREFX_C_MIG_S_CLM alias ClaimsItems
{
  use update;
  use delete;

  use association _Job { with draft; }
}

define behavior for ZREFX_C_MIG_S_COMP alias ComplaintsItems
{
  use update;
  use delete;

  use association _Job { with draft; }
}