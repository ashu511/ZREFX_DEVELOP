projection;
strict;
use draft;
use side effects;
define behavior for ZC_ComplaintsAppConfig_S alias CompConfigAll
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _ComplaintsConfig { create; with draft; }

}

define behavior for ZC_ComplaintsConfig alias ComplaintsConfig
use etag
{
  use update;
  use delete;

  use action Deprecate;
  use action Invalidate;
  use action Copy;

  use association _CompConfigAll { with draft; }

}