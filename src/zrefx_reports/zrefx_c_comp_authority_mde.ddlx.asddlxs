@Metadata.layer: #PARTNER

@UI: {
  headerInfo: {
    typeName: 'Complaint',
    typeNamePlural: 'Complaints',
    title: {
             type:#STANDARD,
            label: 'Complaint',
            value: 'ComplaintId'
           }
  }
}
annotate entity ZREFX_C_COMP_AUTHORITY_REPORT with
{
  @UI: { lineItem: [ { position: 10, label: 'Legal Involvement'  } ],
  identification: [{ position: 10, label: 'Legal Involvement', hidden :true }],
  selectionField: [ { position: 10  } ]
       }
  @EndUserText.label: 'Legal Involvement'
  LegalInvolvement;
  @UI: { lineItem: [ { position: 20, label: 'Authority Level'  } ],
  identification: [{ position: 20, label: 'Authority Level', hidden :true }],
  selectionField: [ { position: 20  } ]
     }
