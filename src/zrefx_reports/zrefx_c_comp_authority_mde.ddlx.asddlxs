  @UI: { lineItem: [ { position: 80, label: 'Legal Decision'  } ],
  identification: [{ position: 80, label: 'Legal Decision', hidden :true }]
     }
  LegalDecision;
  @UI: { lineItem: [ { position: 90, label: 'Final Decision'  } ],
  identification: [{ position: 90, label: 'Final Decision', hidden :true }]
     }
  FinalDecision;
  @UI: { lineItem: [ { position: 100, label: 'Closure Date'  } ],
  identification: [{ position: 100, label: 'Closure Date', hidden :true }]
     }
  ClosureDate;

