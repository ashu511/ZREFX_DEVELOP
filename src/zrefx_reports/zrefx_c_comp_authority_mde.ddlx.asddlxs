  AuthorityLevel;
  @UI: { lineItem: [ { position: 30, label: 'Decision Outcome'  } ],
  identification: [{ position: 30, label: 'Decision Outcome', hidden :true }],
  selectionField: [ { position: 30  } ]
     }
  @EndUserText.label: 'Decision Outcome'
  DecisionOutcome;
  @UI: { lineItem: [ { position: 40, label: 'Submission From Date'  } ],
  identification: [{ position: 40, label: 'Submission From Date', hidden :true }]
     }
  SubmissionFromDate;
  @UI: { lineItem: [ { position: 50, label: 'Submission To Date'  } ],
  identification: [{ position: 50, label: 'Submission To Date', hidden :true }]
     }
  SubmissionToDate;
  @UI: { lineItem: [ { position: 60, label: 'Complaint Id'  } ],
