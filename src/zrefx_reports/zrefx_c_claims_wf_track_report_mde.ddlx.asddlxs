@Metadata.layer: #PARTNER
@EndUserText.label: 'Claim Payment Report'
@UI: {
  headerInfo: {
    typeName: 'Claim',
    typeNamePlural: 'Claims',
    title: {
             type:#STANDARD,
            label: 'Claim Id',
            value: 'ClaimId'
           }
  }
}
@UI.presentationVariant: [{
    sortOrder: [{
        by: 'ApprovalStep',
        direction: #ASC
    }]
}]
annotate entity ZREFX_C_CLAIMS_WF_TRACK_REPORT with
{
  @UI.facet: [
      // --- TABS (Collections) ---
      { id: 'idInfo',
        type: #COLLECTION,
        label: 'Complaint Information',
         position: 10 },

            {
                            id : 'ClaimId',
                            purpose: #STANDARD,
                            type: #IDENTIFICATION_REFERENCE,
                            label: 'Claim Id',
                            parentId:'idInfo',
                            position: 10
                   }
         ]



  @UI: { lineItem: [ { position: 10, label: 'ClaimId'  } ],
  identification: [{ position: 10, label: 'Claim Id' }],
  selectionField: [ { position: 10 } ]
       }
  //  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZREFX_CLMP_ID_VH', element: 'ClaimId' } }]
  ClaimId;
  //   @UI: { lineItem: [ { position: 20, label: 'ClaimId'  } ],
  //  identification: [{ position: 20, label: 'Claim Id' }],
