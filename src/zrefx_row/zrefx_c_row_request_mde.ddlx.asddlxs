@Metadata.layer: #CORE
@UI.createHidden: true
@UI.deleteHidden: true
@UI.headerInfo: {
    typeName: 'ROW Request',
    typeNamePlural: 'ROW Requests',
    title: { value: 'RequestId' },
    description: { value: 'Requestor' }
}

@UI.selectionVariant: [{
  qualifier: 'DefaultStatus',
  text: 'Initial Status Selection',
  filter: 'Statuscode EQ "CANCELLED" OR Statuscode EQ "INPROCESS" OR Statuscode EQ "CLOSED"'
}]




@UI.selectionPresentationVariant: [{
  id: 'DefaultView',
  text: 'Default View',
  qualifier: 'DefaultStatusSPV',
  selectionVariantQualifier: 'DefaultStatus',
  presentationVariantQualifier: 'Default' // Points to your @UI.presentationVariant
}]

@UI.presentationVariant: [{
  qualifier: 'Default',
  visualizations: [{ type: #AS_LINEITEM }]
}]
annotate entity ZREFX_C_ROW_REQUEST with
{


  /* =====================================================================
       1. FACET LAYOUT
       ===================================================================== */
  @UI.facet: [
    // --- TABS (Collections) ---

    { id: 'idReqestorDetails',         type: #COLLECTION, label: 'Requestor and Requestor Details',        position: 10 },
    { id: 'idRequestDetails',          type: #COLLECTION, label: 'Request Details',                        position: 20 },
    { id: 'idProjectDetails',          type: #COLLECTION, label: 'Project Details',                        position: 30 },
  //    { id: 'idProjSpecs',               type: #COLLECTION, label: 'Project/Station Specification',          position: 40 },
    { id: 'idDimension',               type: #COLLECTION, label: 'Land Dimension',                         position: 50 },
   { id: 'idGis',               type: #COLLECTION, label: 'Geographical Location Details',                 position: 60 },
  //   { id: 'idDocs',                 type: #LINEITEM_REFERENCE, label: 'Documents',                      position: 70, targetElement: '_Attachments' },

    { id: 'idDisc',                    type: #COLLECTION, label: 'Disclaimer',                             position: 80 },


    // --- SECTIONS (Inside the Tabs) ---

    { id: 'IdReqestorDetails',  type: #FIELDGROUP_REFERENCE, label: 'Initiator Details',                  parentId: 'idReqestorDetails',  targetQualifier: 'tqReqestorDetails', position: 10 },
    { id: 'IdRequestDetails',   type: #FIELDGROUP_REFERENCE, label: 'Request Details',                    parentId: 'idRequestDetails',   targetQualifier: 'tqRequestDetails',  position: 10 },
    { id: 'IdProjectDetails',   type: #FIELDGROUP_REFERENCE, label: 'Project Details',                    parentId: 'idProjectDetails',   targetQualifier: 'tqProjectDetails',  position: 10 },
  //    { id: 'IdProjSpecs',        type: #FIELDGROUP_REFERENCE, label: 'Project/Station Specification',      parentId: 'idProjSpecs',        targetQualifier: 'tqProjSpecs',       position: 10 },
    { id: 'IdDimension',        type: #FIELDGROUP_REFERENCE, label: 'Land Dimension',                     parentId: 'idDimension',        targetQualifier: 'tqDimension',       position: 10 },
     { id: 'IdGis',        type: #FIELDGROUP_REFERENCE, label: 'Geographical Location Details',           parentId: 'idGis',              targetQualifier: 'tqGis',             position: 10 },
    { id: 'IdDisc',             type: #FIELDGROUP_REFERENCE, label: 'Disclaimer',                         parentId: 'idDisc',             targetQualifier: 'tqDisc',            position: 10 }
  ]

  // Request Details
  @EndUserText.label: 'Request  ID'
  @UI.lineItem: [{ position: 10 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'tqRequestDetails' }]
  @Search.defaultSearchElement: true
  RequestId;

  @EndUserText.label: 'Request  Date'
  @UI.lineItem: [{ position: 20 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'tqRequestDetails' }]
  Requestdate;
  @EndUserText.label: 'Request  type'
  @UI.lineItem: [{ position: 30 }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'tqRequestDetails' }]
  Requesttype;

  @EndUserText.label: 'Status'
  @UI.lineItem: [{ position: 35 }]
  @UI.fieldGroup: [{ position: 35, qualifier: 'tqRequestDetails' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZREFX_DOV_STATUS', element: 'Value'} }]
  Statuscode;
    @EndUserText.label: 'Status Description'
  @UI.lineItem: [{ position: 36 }]
  @UI.fieldGroup: [{ position: 36, qualifier: 'tqRequestDetails' }]
   StatusDescription;
  @EndUserText.label: 'Request Description'
  @UI.lineItem: [{ position: 40 }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'tqRequestDetails' }]
  Requestdescription;
  @EndUserText.label: 'Request Purpose'
  @UI.lineItem: [{ position: 50 }]
  @UI.fieldGroup: [{ position: 50, qualifier: 'tqRequestDetails' }]
  Requestpurpose;
  @EndUserText.label: 'Requestor Name'
  @UI.lineItem: [{ position: 60 }]
  @UI.fieldGroup: [{ position: 60, qualifier: 'tqRequestDetails' }]
  Requestor;
  @EndUserText.label: 'Business Justification'
  @UI.lineItem: [{ position: 70 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqRequestDetails' }]
  Businessjustification;
  @EndUserText.label: 'Previous Requestno'
  @UI.lineItem: [{ position: 80 }]
  @UI.fieldGroup: [{ position: 80, qualifier: 'tqRequestDetails' }]
  Previousrequestno;
  @EndUserText.label: 'Requestor Comments'
  @UI.lineItem: [{ position: 90 }]
  @UI.fieldGroup: [{ position: 90, qualifier: 'tqRequestDetails' }]
  Requestorcomments;
  @EndUserText.label: 'Additional Comments'
  @UI.lineItem: [{ position: 100 }]
  @UI.fieldGroup: [{ position: 100, qualifier: 'tqRequestDetails' }]
  Additionalcomments;


  //Project Details
  @EndUserText.label: 'Wbs project No'
  @UI.lineItem: [{ position: 200 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'tqProjectDetails' }]
  Wbsprojectno;
  @EndUserText.label: 'Stagegate Projectno'
  @UI.lineItem: [{ position: 210 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'tqProjectDetails' }]
  Stagegateprojectno;
  @EndUserText.label: 'Project Start Date'
  @UI.lineItem: [{ position: 220 }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'tqProjectDetails' }]
  Projectstartdate;
  @EndUserText.label: 'Hijri Start Date'
  @UI.lineItem: [{ position: 230 }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'tqProjectDetails' }]
  Hijristartdate;
  @EndUserText.label: 'Plan Completion Date'
  @UI.lineItem: [{ position: 240 }]
  @UI.fieldGroup: [{ position: 50, qualifier: 'tqProjectDetails' }]
  Plancompletiondate;
  @EndUserText.label: 'Project Budget Year'
  @UI.lineItem: [{ position: 250 }]
  @UI.fieldGroup: [{ position: 60, qualifier: 'tqProjectDetails' }]
  Projectbudgetyear;
  @EndUserText.label: 'Volt age kv'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Voltagekv;
  @EndUserText.label: ' Project Name'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Projectname;
  @EndUserText.label: ' Project Arabic Name'
  @UI.lineItem: [{ position: 265 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  ProjectnameA;
  @EndUserText.label: 'Project Approval Year'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Projectapprovalyear;
  @EndUserText.label: 'Project End Date'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Projectenddate;
  @EndUserText.label: 'Hijri End Date'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Hijrienddate;
  @EndUserText.label: 'Actual Completion Date'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Actualcompletiondate;
  @EndUserText.label: 'Project Cost SAR'
  @UI.lineItem: [{ position: 260 }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'tqProjectDetails' }]
  Projectcostsar;

  @EndUserText.label: 'Estimated Project Cost SAR'
  @UI.lineItem: [{ position: 261 }]
  @UI.fieldGroup: [{ position: 80, qualifier: 'tqProjectDetails' }]
  EstimatedProjectCost;

  //Ritght of way Requirement Details
  @EndUserText.label: 'Length'
  @UI.lineItem: [{ position: 300 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'tqDimension' }]
  Lengthmrequested;
  @EndUserText.label: 'Area'
  @UI.lineItem: [{ position: 310 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'tqDimension' }]
  Areasqmrequested;
  @EndUserText.label: 'Width'
  @UI.lineItem: [{ position: 320 }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'tqDimension' }]
  Widthmrequested;



  //Geographic Location
  @EndUserText.label: 'City'
  @UI.lineItem: [{ position: 400 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'tqGis' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZREFX_DOV_CITY', element: 'Value'} }]
  City;
  @EndUserText.label: 'Region'
  @UI.lineItem: [{ position: 410 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'tqGis' }]
  Region;

  @EndUserText.label: 'GIS Id'
  @UI.lineItem: [{ position: 430 }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'tqGis' }]
  Gisprojectid;

  @EndUserText.label: 'Gis Link'
  @UI.lineItem: [{ position: 440 }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'tqGis' }]
  Gislocationlink;
  @EndUserText.label: 'Gis Drawing'
  @UI.lineItem: [{ position: 450 }]
  @UI.fieldGroup: [{ position: 50, qualifier: 'tqGis' }]
  Gisdrawing;
  @EndUserText.label: 'Site area'
  @UI.lineItem: [{ position: 460 }]
  @UI.fieldGroup: [{ position: 60, qualifier: 'tqGis' }]
  Sitearea;


  @EndUserText.label: 'Initiator Id'
  @UI.lineItem: [{ position: 500 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'tqReqestorDetails' }]
  Initiatorid;
  @EndUserText.label: 'Employee Number'
  @UI.lineItem: [{ position: 510 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'tqReqestorDetails' }]
