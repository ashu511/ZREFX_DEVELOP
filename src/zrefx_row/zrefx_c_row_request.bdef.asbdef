projection;
strict ( 2 );

define behavior for ZREFX_C_ROW_REQUEST //alias <alias_name>
{
  use create;
  use update;
  use delete;


  use association _RequestAttachments { create; }
//  use association _WorkflowInstance { create; }
  use association _ROWWorkflowInfo { create; }
}





define behavior for ZREFX_C_ROW_REQUEST_ATTACHMENT //alias <alias_name>
{
  use update;
  use delete;

  use association _ROWRequest;
}

